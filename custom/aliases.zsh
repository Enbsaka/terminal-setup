# ==============================
# Aliases personalizados
# ==============================

# --- Navegação ---
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias ~="cd ~"

# --- Git (oh-my-zsh já tem vários, mas aqui vão extras) ---
alias gs="git status"
alias gc="git commit"
alias gca="git commit --amend"
alias gp="git push"
alias gl="git pull"

# --- Listagem (ls com opções) ---
alias ls="ls --color=auto"
alias ll="ls -la"
alias la="ls -A"
alias l="ls -CF"

# --- Outros ---
alias c="clear"
alias h="history"
alias zshrc="source ~/.zshrc"
